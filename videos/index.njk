<script>
  document.querySelectorAll('.video-thumb').forEach(function(thumb) {
    thumb.addEventListener('click', function() {
      var id = thumb.dataset.id;
      var embed = document.createElement('div');
      embed.className = 'video-embed';
      embed.innerHTML = '<iframe src="https://www.youtube.com/embed/' + id + '?autoplay=1" allowfullscreen allow="autoplay; encrypted-media" title="Video player"></iframe>';
      thumb.replaceWith(embed);
    });
  });
</script>
