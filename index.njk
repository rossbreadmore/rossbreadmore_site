---
title: Ross Breadmore
layout: home.njk
---

<div class="homepage-hero">
  <div class="hero-text">
    <h1 class="hero-name">Ross<br>Breadmore</h1>
    <p class="hero-bio">Design leadership for complex organisations. Twenty years building good teams who design good things.</p>
  </div>
  <div class="hero-illustration">
    {% include "illustrations/robot.svg" %}
  </div>
</div>

<section class="writing-section">
  <h2 class="section-label">Writing</h2>
  <ul class="post-list">
    {% for post in collections.posts %}
      <li>
        <a href="{{ post.url }}">
          <span class="post-list-title">{{ post.data.title }}</span>
          <span class="post-list-date">{{ post.date | date("MMM yyyy") }}</span>
        </a>
      </li>
    {% endfor %}
  </ul>
</section>
