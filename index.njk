---
title: Ross Breadmore
layout: home.njk
---

<section class="intro-timeline">

  <div class="timeline">

    {% for item in timeline %}
    <div class="timeline-item" data-side="{{ item.side }}">
      <div class="timeline-node"><span>{{ item.number }}</span></div>
      <div class="timeline-body">
        <button class="timeline-trigger">
          <span class="skill-icon">{{ item.icon | safe }}</span>
          <span class="skill-name">{{ item.skill }}</span>
          <span class="skill-company">{{ item.company }}</span>
        </button>
        <div class="timeline-detail">
          <p>{{ item.detail }}</p>
        </div>
      </div>
    </div>
    {% endfor %}

  </div>

</section>

<ul class="post-list">
  {% for post in collections.posts %}
    <li>
      <a href="{{ post.url }}">
        <span class="post-list-title">{{ post.data.title }}</span>
        <span class="post-list-date">{{ post.date | date("MMM yyyy") }}</span>
      </a>
    </li>
  {% endfor %}
</ul>

<script>
  var items = document.querySelectorAll('.timeline-item');

  items.forEach(function(item) {
    var trigger = item.querySelector('.timeline-trigger');

    trigger.addEventListener('click', function() {
      var isOpen = item.classList.contains('is-open');

      items.forEach(function(i) {
        i.classList.remove('is-open', 'is-dimmed');
      });

      if (!isOpen) {
        item.classList.add('is-open');
        items.forEach(function(i) {
          if (i !== item) i.classList.add('is-dimmed');
        });
      }
    });
  });
</script>
