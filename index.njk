---
title: KNEAD
layout: home.njk
---

<section class="catalogue-section">

  <div class="catalogue-header">
    <div class="catalogue-title">KNEAD</div>
    <p class="catalogue-sub">A label built from experience.</p>
  </div>

  <div class="catalogue-divider">
    <span class="catalogue-col-label">Catalogue</span>
  </div>

  <ul class="catalogue-list">
    {% for item in timeline %}
    <li class="catalogue-item">
      <button class="catalogue-trigger">
        <span class="cat-num">{{ item.catalogue }}</span>
        <span class="cat-name">{{ item.skill }}</span>
        <span class="cat-company">{{ item.company }}</span>
        <span class="cat-expand">+</span>
      </button>
      <div class="cat-detail">
        <p>{{ item.detail }}</p>
      </div>
    </li>
    {% endfor %}
  </ul>

  <p class="catalogue-footnote">Twenty years. Six pressings. All titles in print.</p>

</section>

<ul class="post-list">
  {% for post in collections.posts %}
    <li>
      <a href="{{ post.url }}">
        <span class="post-list-title">{{ post.data.title }}</span>
        <span class="post-list-date">{{ post.date | date("MMM yyyy") }}</span>
      </a>
    </li>
  {% endfor %}
</ul>

<script>
  var items = document.querySelectorAll('.catalogue-item');

  items.forEach(function(item) {
    var trigger = item.querySelector('.catalogue-trigger');

    trigger.addEventListener('click', function() {
      var isOpen = item.classList.contains('is-open');

      items.forEach(function(i) {
        i.classList.remove('is-open', 'is-dimmed');
      });

      if (!isOpen) {
        item.classList.add('is-open');
        items.forEach(function(i) {
          if (i !== item) i.classList.add('is-dimmed');
        });
      }
    });
  });
</script>
