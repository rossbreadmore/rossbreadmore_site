---
title: Ross Breadmore
layout: home.njk
---

<div class="hero">
  <h1 class="hero-title">Ross<br>Breadmore</h1>
  <p class="hero-sub">A digital sketchbook for things I'm making and doing and thinking</p>
</div>

<ul class="post-list">
  {% for post in collections.posts %}
    <li>
      <a href="{{ post.url }}">
        <span class="post-list-title">{{ post.data.title }}</span>
        <span class="post-list-date">{{ post.date | date("MMM yyyy") }}</span>
      </a>
    </li>
  {% endfor %}
</ul>
