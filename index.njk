---
title: Ross Breadmore
layout: home.njk
---

<section class="recipe-section">

  <div class="recipe-hero">BREAD</div>

  <div class="recipe-body">
    <div class="recipe-label">Ingredients</div>
    <ul class="ingredient-list">
      {% for item in timeline %}
      <li class="ingredient-item">
        <button class="ingredient-trigger">
          <span class="ing-qty">{{ item.quantity }}</span>
          <span class="ing-name">{{ item.skill }}</span>
          <span class="ing-company">{{ item.company }}</span>
        </button>
        <div class="ing-detail">
          <p>{{ item.detail }}</p>
        </div>
      </li>
      {% endfor %}
    </ul>
    <p class="recipe-method">Combine. Prove for 20 years. Apply heat.</p>
  </div>

</section>

<ul class="post-list">
  {% for post in collections.posts %}
    <li>
      <a href="{{ post.url }}">
        <span class="post-list-title">{{ post.data.title }}</span>
        <span class="post-list-date">{{ post.date | date("MMM yyyy") }}</span>
      </a>
    </li>
  {% endfor %}
</ul>

<script>
  var items = document.querySelectorAll('.ingredient-item');

  items.forEach(function(item) {
    var trigger = item.querySelector('.ingredient-trigger');

    trigger.addEventListener('click', function() {
      var isOpen = item.classList.contains('is-open');

      items.forEach(function(i) {
        i.classList.remove('is-open', 'is-dimmed');
      });

      if (!isOpen) {
        item.classList.add('is-open');
        items.forEach(function(i) {
          if (i !== item) i.classList.add('is-dimmed');
        });
      }
    });
  });
</script>
