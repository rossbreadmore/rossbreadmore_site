---
title: Ross Breadmore
layout: home.njk
---

<section class="name-scaffold">
  {% for group in timeline %}
  <div class="name-section">
    <div class="name-word">{{ group.word }}</div>
    <div class="name-items">
      {% for item in group.items %}
      <div class="name-item">
        <button class="name-trigger">
          <span class="ni-num">{{ item.number }}</span>
          <span class="ni-icon">{{ item.icon | safe }}</span>
          <span class="ni-skill">{{ item.skill }}</span>
          <span class="ni-company">{{ item.company }}</span>
        </button>
        <div class="ni-detail">
          <p>{{ item.detail }}</p>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endfor %}
</section>

<ul class="post-list">
  {% for post in collections.posts %}
    <li>
      <a href="{{ post.url }}">
        <span class="post-list-title">{{ post.data.title }}</span>
        <span class="post-list-date">{{ post.date | date("MMM yyyy") }}</span>
      </a>
    </li>
  {% endfor %}
</ul>

<script>
  var items = document.querySelectorAll('.name-item');

  items.forEach(function(item) {
    var trigger = item.querySelector('.name-trigger');

    trigger.addEventListener('click', function() {
      var isOpen = item.classList.contains('is-open');

      items.forEach(function(i) {
        i.classList.remove('is-open', 'is-dimmed');
      });

      if (!isOpen) {
        item.classList.add('is-open');
        items.forEach(function(i) {
          if (i !== item) i.classList.add('is-dimmed');
        });
      }
    });
  });
</script>
