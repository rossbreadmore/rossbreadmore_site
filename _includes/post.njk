<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>{{ title }}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/styles.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <div class="site-wrapper">

    <header class="site-header">
      <a href="/" class="site-logo">Ross Breadmore</a>
      <nav>
        <a href="/faq/">FAQ</a>
        <a href="https://www.linkedin.com/in/rossbreadmore/" target="_blank">LinkedIn</a>
        <a href="https://rossbreadmore.medium.com/" target="_blank">Medium</a>
        <a href="https://github.com/rossbreadmore" target="_blank">GitHub</a>
      </nav>
    </header>

    <main>
      <article>
        <div class="post-header">
          <h1 class="post-title">{{ title }}</h1>
          {% if date %}
            <p class="post-date">{{ date | date("MMMM d, yyyy") }}</p>
          {% endif %}
        </div>
        <div class="post-content">
          {{ content | safe }}
        </div>
      </article>
    </main>

    <footer>
      <p>© Ross Breadmore</p>
      <div class="footer-links">
        <a href="/faq/">FAQ</a>
        <a href="https://www.linkedin.com/in/rossbreadmore/" target="_blank">LinkedIn</a>
        <a href="https://rossbreadmore.medium.com/" target="_blank">Medium</a>
        <a href="https://github.com/rossbreadmore" target="_blank">GitHub</a>
      </div>
    </footer>

  </div>

</body>
</html>
