<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="robots" content="noindex, nofollow">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #FAF8F5;
      --bg-warm: #F3EFE8;
      --ink: #1C1A18;
      --ink-mid: #5a5650;
      --ink-light: #9a958e;
      --accent: #B06A3E;
      --accent-light: #f0e0d4;
      --border: #E0DAD2;
      --white: #ffffff;
      --serif: 'Cormorant Garamond', Georgia, serif;
      --sans: 'Inter', system-ui, sans-serif;
      --max: 1080px;
      --gutter: clamp(1.5rem, 5vw, 4rem);
    }

    html { font-size: 18px; scroll-behavior: smooth; }

    body {
      background: var(--bg);
      color: var(--ink);
      font-family: var(--sans);
      font-weight: 300;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    /* ── UTILITY ── */
    .wrap {
      max-width: var(--max);
      margin: 0 auto;
      padding: 0 var(--gutter);
    }

    .eyebrow {
      font-family: var(--sans);
      font-size: 0.7rem;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--accent);
    }

    .rule {
      border: none;
      border-top: 1px solid var(--border);
      margin: 0;
    }

    /* ── BACK LINK ── */
    .back-link {
      display: block;
      padding: 1.25rem var(--gutter);
      font-family: var(--sans);
      font-size: 0.72rem;
      font-weight: 400;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ink-light);
      text-decoration: none;
      border-bottom: 1px solid var(--border);
    }
    .back-link:hover { color: var(--accent); }

    /* ── HERO ── */
    .hero {
      padding: clamp(3rem, 8vw, 6rem) var(--gutter) clamp(2rem, 6vw, 4.5rem);
      max-width: var(--max);
      margin: 0 auto;
    }

    .hero-eyebrow {
      margin-bottom: 1.5rem;
    }

    .hero h1 {
      font-family: var(--serif);
      font-weight: 300;
      font-size: clamp(3rem, 8vw, 6rem);
      line-height: 1.0;
      letter-spacing: -0.02em;
      color: var(--ink);
      margin-bottom: 1.5rem;
    }

    .hero h1 em {
      font-style: italic;
      color: var(--accent);
    }

    .hero-sub {
      max-width: 560px;
      font-size: clamp(1rem, 2vw, 1.15rem);
      line-height: 1.65;
      color: var(--ink-mid);
      margin-bottom: 2.5rem;
    }

    .hero-cta {
      display: inline-block;
      background: var(--accent);
      color: var(--white);
      font-family: var(--sans);
      font-size: 0.78rem;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      text-decoration: none;
      padding: 1rem 2rem;
      transition: background 0.15s;
    }
    .hero-cta:hover { background: var(--ink); }

    .hero-cta-note {
      display: block;
      margin-top: 0.75rem;
      font-size: 0.75rem;
      color: var(--ink-light);
    }

    /* ── SECTION COMMON ── */
    section {
      border-top: 1px solid var(--border);
    }

    .section-inner {
      max-width: var(--max);
      margin: 0 auto;
      padding: clamp(2.5rem, 6vw, 5rem) var(--gutter);
    }

    .section-header {
      margin-bottom: 2.5rem;
    }

    .section-header h2 {
      font-family: var(--serif);
      font-weight: 300;
      font-size: clamp(2rem, 4vw, 3rem);
      line-height: 1.1;
      letter-spacing: -0.01em;
      margin-top: 0.5rem;
    }

    /* ── INTRO / PHILOSOPHY ── */
    .intro-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: clamp(2rem, 5vw, 5rem);
      align-items: start;
    }

    @media (max-width: 700px) {
      .intro-grid { grid-template-columns: 1fr; }
    }

    .intro-body p {
      font-size: 1.05rem;
      line-height: 1.75;
      color: var(--ink-mid);
      margin-bottom: 1.2rem;
    }

    .intro-body p:last-child { margin-bottom: 0; }

    .intro-pull {
      font-family: var(--serif);
      font-size: clamp(1.5rem, 3vw, 2.1rem);
      font-weight: 300;
      font-style: italic;
      line-height: 1.35;
      color: var(--ink);
      border-left: 2px solid var(--accent);
      padding-left: 1.5rem;
    }

    /* ── CONDITIONS ── */
    .conditions-bg {
      background: var(--bg-warm);
    }

    .conditions-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 0;
    }

    .condition-item {
      padding: 1rem 0;
      border-bottom: 1px solid var(--border);
      font-size: 0.95rem;
      color: var(--ink-mid);
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    .condition-item::before {
      content: '';
      display: block;
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: var(--accent);
      flex-shrink: 0;
    }

    .conditions-note {
      margin-top: 2rem;
      font-size: 0.82rem;
      color: var(--ink-light);
      line-height: 1.6;
    }

    .conditions-note a {
      color: var(--accent);
      text-decoration: underline;
    }

    /* ── HOW IT WORKS ── */
    .steps-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1px;
      background: var(--border);
      border: 1px solid var(--border);
      margin-top: 0.5rem;
    }

    @media (max-width: 700px) {
      .steps-grid { grid-template-columns: 1fr; }
    }

    .step {
      background: var(--bg);
      padding: 2rem;
    }

    .step-num {
      font-family: var(--serif);
      font-size: 2.5rem;
      font-weight: 300;
      color: var(--accent-light);
      line-height: 1;
      margin-bottom: 1rem;
    }

    .step h3 {
      font-family: var(--serif);
      font-size: 1.3rem;
      font-weight: 400;
      line-height: 1.2;
      margin-bottom: 0.75rem;
    }

    .step-detail {
      font-size: 0.9rem;
      line-height: 1.65;
      color: var(--ink-mid);
    }

    .step-price {
      display: inline-block;
      margin-top: 1rem;
      font-size: 0.72rem;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--accent);
      background: var(--accent-light);
      padding: 0.3rem 0.7rem;
    }

    /* ── LOCATIONS ── */
    .locations-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: clamp(1.5rem, 4vw, 3rem);
      margin-top: 0.5rem;
    }

    @media (max-width: 600px) {
      .locations-grid { grid-template-columns: 1fr; }
    }

    .location-card {
      border: 1px solid var(--border);
      padding: 2rem;
    }

    .location-card h3 {
      font-family: var(--serif);
      font-size: 1.3rem;
      font-weight: 400;
      margin-bottom: 0.25rem;
    }

    .location-card .location-area {
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink-light);
      margin-bottom: 1.25rem;
    }

    .location-hours {
      list-style: none;
      margin-bottom: 1.5rem;
    }

    .location-hours li {
      display: flex;
      justify-content: space-between;
      font-size: 0.9rem;
      padding: 0.4rem 0;
      border-bottom: 1px solid var(--border);
      color: var(--ink-mid);
    }

    .location-hours li span:first-child {
      font-weight: 400;
      color: var(--ink);
    }

    .location-link {
      display: inline-block;
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--accent);
      text-decoration: none;
      border-bottom: 1px solid var(--accent);
      padding-bottom: 2px;
      margin-right: 1.25rem;
    }
    .location-link:hover { color: var(--ink); border-color: var(--ink); }

    /* ── TESTIMONIALS ── */
    .testimonials-bg {
      background: var(--ink);
    }

    .testimonials-bg .eyebrow {
      color: var(--accent-light);
    }

    .testimonials-bg .section-header h2 {
      color: var(--white);
    }

    .testimonials-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }

    @media (max-width: 700px) {
      .testimonials-grid { grid-template-columns: 1fr; }
    }

    .testimonial {
      border: 1px solid rgba(255,255,255,0.12);
      padding: 2rem;
    }

    .testimonial blockquote {
      font-family: var(--serif);
      font-size: clamp(1rem, 2vw, 1.2rem);
      font-weight: 300;
      font-style: italic;
      line-height: 1.6;
      color: rgba(255,255,255,0.9);
      margin-bottom: 1.25rem;
    }

    .testimonial cite {
      font-style: normal;
      font-size: 0.72rem;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--accent-light);
    }

    .testimonial-featured {
      grid-column: 1 / -1;
      border-color: var(--accent);
    }

    .testimonial-featured blockquote {
      font-size: clamp(1.1rem, 2.5vw, 1.45rem);
    }

    /* ── CTA BAND ── */
    .cta-band {
      background: var(--accent);
      padding: clamp(2.5rem, 5vw, 4rem) var(--gutter);
      text-align: center;
    }

    .cta-band h2 {
      font-family: var(--serif);
      font-weight: 300;
      font-style: italic;
      font-size: clamp(1.8rem, 4vw, 3rem);
      color: var(--white);
      margin-bottom: 0.5rem;
    }

    .cta-band p {
      color: rgba(255,255,255,0.8);
      font-size: 0.9rem;
      margin-bottom: 2rem;
    }

    .cta-band-btn {
      display: inline-block;
      background: var(--white);
      color: var(--accent);
      font-family: var(--sans);
      font-size: 0.78rem;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      text-decoration: none;
      padding: 1rem 2.5rem;
      transition: background 0.15s, color 0.15s;
    }
    .cta-band-btn:hover {
      background: var(--ink);
      color: var(--white);
    }

    /* ── FOOTER ── */
    .site-footer {
      border-top: 1px solid var(--border);
      padding: 2rem var(--gutter);
    }

    .footer-inner {
      max-width: var(--max);
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
      font-size: 0.78rem;
      color: var(--ink-light);
    }

    .footer-inner a {
      color: var(--ink-light);
      text-decoration: none;
    }
    .footer-inner a:hover { color: var(--accent); }

    .bacc-badge {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.72rem;
      letter-spacing: 0.06em;
    }

    .bacc-badge::before {
      content: '';
      display: block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--accent);
    }
  </style>
</head>
<body>

  <a href="https://rossbreadmore.com" class="back-link">← rossbreadmore.com</a>

  {{ content | safe }}

  <footer class="site-footer">
    <div class="footer-inner">
      <div class="bacc-badge">Registered member of the British Acupuncture Council</div>
      <div>© Charlotte Breadmore {{ page.date | date("yyyy") }}</div>
    </div>
  </footer>

</body>
</html>
